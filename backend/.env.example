# Khalti Payment Gateway Configuration
# Get these from https://khalti.com/ after signing up
KHALTI_PUBLIC_KEY=your_khalti_public_key_here
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_API_URL=https://a.khalti.com/api/v2

# Application Base URL (frontend URL for redirects)
APP_BASE_URL=http://localhost:5173

# Database Configuration (PostgreSQL - required)
DATABASE_URL=jdbc:postgresql://localhost:5432/desn
DATABASE_USERNAME=desn_user
DATABASE_PASSWORD=desn_password

# CORS Configuration
# Development includes local ports; add production domains for staging if needed.
# Use APP_CORS_ALLOWED_ORIGINS / APP_CORS_MAX_AGE (Spring maps hyphenated properties).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://desnepal.org,https://www.desnepal.org
APP_CORS_MAX_AGE=86400

# Email Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
EMAIL_NOTIFICATIONS_ENABLED=false
ADMIN_EMAIL=admin@desnepal.com
FROM_EMAIL=noreply@desnepal.com

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=86400000

# Storage Mode (file or database)
STORAGE_MODE=database
FILE_STORAGE_DIR=src/main/resources/static/resources

# File Upload Limits
MAX_FILE_SIZE=52428800
